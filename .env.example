NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/svvv-notes
SESSION_SECRET=your-session-secret-here

# Cloudinary Credentials (Optional - fallback to local storage if not provided)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret
CLOUDINARY_FOLDER=SVVV_Notes/pdfs

# Email Service Option 1: Resend API (Recommended for production with custom domain)
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev

# Email Service Option 2: Gmail SMTP / Nodemailer (Send to ANY student email for free)
# Create App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_google_app_password

# Production Website Domain (used for canonical URLs, Open Graph, Sitemap & SEO metadata)
SITE_URL=https://svvv-notes.onrender.com
