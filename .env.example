NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/svvv-notes
SESSION_SECRET=your_secure_session_secret_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret
CLOUDINARY_FOLDER=SVVV_Notes/pdfs

# urBackend Transactional Mail API
# 1. Get your Secret Key (sk_live_...) from https://urbackend.bitbros.in/dashboard
URBACKEND_SECRET_KEY=your_urbackend_secret_key_here
# Alias for URBACKEND_SECRET_KEY
URBACKEND_API_KEY=your_urbackend_secret_key_here
# Optional template names (if using template mode):
# URBACKEND_OTP_TEMPLATE=otp-verification
# URBACKEND_WELCOME_TEMPLATE=welcome
# URBACKEND_RESET_PASSWORD_TEMPLATE=password-reset
SENDER_EMAIL=noreply@svvvnotes.bitbros.in

# Production Base URLs (used for password reset links, verification, canonical URLs & sitemap)
BASE_URL=https://svvvnotes.bitbros.in
SITE_URL=https://svvvnotes.bitbros.in

# Google OAuth 2.0 (passport-google-oauth20)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Callback URL registered in Google Console (e.g. for Render or localhost):
# GOOGLE_CALLBACK_URL=https://svvv-notes.onrender.com/auth/google/callback
# Or for local development:
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=https://svvv-notes.onrender.com/auth/google/callback

