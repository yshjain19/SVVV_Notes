<% layout('layouts/boilerplate') %>
<section class="page-hero compact">
  <div class="container text-center">
    <span class="section-kicker">OUR STORY</span>
    <h1>Learning works better<br />when we share it.</h1>
    <p>
      SVVV_Notes is a student-driven initiative with a simple mission: make
      curated study material accessible, organized, and open for everyone.
    </p>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="section-kicker">BUILT WITH PURPOSE</span>
        <h2>A resource library that feels like a community.</h2>
        <p class="lead text-secondary">
          We believe the notes you make today can unlock confidence for someone
          else tomorrow.
        </p>
        <p class="text-secondary">
          SVVV_Notes is an independent platform created for the SVVV CSE
          student community. It is not affiliated with or an official product of
          Shri Vaishnav Vidyapeeth Vishwavidyalaya.
        </p>
      </div>
      <div class="col-lg-6">
        <div class="about-card">
          <i class="bi bi-people-fill"></i>
          <h3>Made by students</h3>
          <p>
            Focused on practical help: less searching, more learning, and a
            place to contribute back.
          </p>
          <div class="about-line"></div>
          <div class="d-flex gap-4">
            <span><strong>100%</strong><small>Student-led</small></span>
            <span><strong>∞</strong><small>Knowledge shared</small></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Meet the Creator Section -->
<section class="section-pad section-tint">
  <div class="container">
    <div class="section-heading text-center mb-5">
      <span class="section-kicker">THE CREATOR</span>
      <h2>Behind SVVV_Notes</h2>
      <p>Created and maintained with dedication to empower fellow students.</p>
    </div>
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card admin-card p-4 p-md-5 text-center shadow-sm">
          <div class="avatar-lg mx-auto mb-3" style="width: 76px; height: 76px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; display: grid; place-items: center; font-size: 2rem; font-weight: 800; box-shadow: var(--shadow-primary);">
            Y
          </div>
          <h3 class="fw-bold mb-1" style="font-size: 1.45rem;">Yash Jain</h3>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-3 mx-auto" style="font-size: 0.8rem;">
            <i class="bi bi-code-slash me-1"></i> Founder & Lead Developer
          </span>
          <p class="text-secondary mb-4 leading-relaxed" style="font-size: 0.92rem;">
            Built SVVV_Notes to solve the challenge of fragmented study resources and scattered revision papers. Passionate about software development, open-source tools, and building platforms that genuinely help students succeed.
