          <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a href="https://www.linkedin.com/in/yash-jain-6b6647320/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm px-3 rounded-pill d-inline-flex align-items-center gap-2">
              <i class="bi bi-linkedin"></i> Connect on LinkedIn
            </a>
            <a href="https://github.com/yshjain19" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm px-3 rounded-pill d-inline-flex align-items-center gap-2">
              <i class="bi bi-github"></i> GitHub Profile
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
