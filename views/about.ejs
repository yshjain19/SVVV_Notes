<% layout('layouts/boilerplate') %>
<section class="page-hero compact">
  <div class="container text-center">
    <span class="section-kicker">OUR STORY</span>
    <h1>Learning works better<br />when we share it.</h1>
    <p>
      SVVV_Notes is a small student project with a simple mission: make
      useful study material easier to find.
    </p>
  </div>
</section>
<section class="section-pad">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="section-kicker">BUILT WITH PURPOSE</span>
        <h2>A resource library that feels like a community.</h2>
        <p class="lead text-secondary">
          We believe the notes you make today can unlock confidence for someone
          else tomorrow.
        </p>
        <p class="text-secondary">
          SVVV_Notes is an independent platform created for the SVVV CSE
          student community. It is not affiliated with or an official product of
          Shri Vaishnav Vidyapeeth Vishwavidyalaya.
        </p>
      </div>
      <div class="col-lg-6">
        <div class="about-card">
          <i class="bi bi-people-fill"></i>
          <h3>Made by students</h3>
          <p>
            Focused on practical help: less searching, more learning, and a
            place to contribute back.
          </p>
          <div class="about-line"></div>
          <div class="d-flex gap-4">
            <span><strong>100%</strong><small>Student-led</small></span
            ><span><strong>∞</strong><small>Knowledge shared</small></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
