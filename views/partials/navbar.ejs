<nav class="navbar navbar-expand-lg navbar-light sticky-top nav-glass">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <span class="brand-mark">
        <img src="/images/logo-icon.svg" alt="SVVV_Notes logo" width="19" height="19" style="display:block;" />
      </span>
      <span>SVVV_<span class="text-primary">Notes</span></span>
    </a>
    <button
      class="navbar-toggler border-0 shadow-none p-2"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#nav"
      aria-controls="nav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <i class="bi bi-list fs-2 text-dark"></i>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav mx-auto gap-lg-1 my-2 my-lg-0">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item">
          <a class="nav-link" href="/notes">Browse notes</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/requests">
            Requests <span class="badge bg-primary-subtle text-primary rounded-pill ms-1" style="font-size: 0.65rem;">New</span>
          </a>
        </li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item">
          <a class="nav-link" href="/contact">Contact</a>
        </li>
        <% if (currentUser && currentUser.isAdmin) { %>
        <li class="nav-item">
          <a class="nav-link text-primary fw-bold" href="/admin/dashboard">Dashboard</a>
        </li>
        <% } %>
      </ul>
      <div class="nav-actions d-flex align-items-center gap-2 mt-3 mt-lg-0 pt-2 pt-lg-0 border-top border-lg-0">
        <% if (currentUser) { %>
          <a class="btn btn-soft flex-grow-1 flex-lg-grow-0" href="/notes/new">
            <i class="bi bi-cloud-arrow-up me-1"></i> Upload
          </a>
          <a class="avatar-link" href="/users/<%= currentUser._id %>" title="View Profile">
            <span class="avatar-sm">
              <%= currentUser.username?.charAt(0).toUpperCase() %>
            </span>
          </a>
        <% } else { %>
          <a class="btn btn-link text-dark text-decoration-none px-3 flex-grow-1 flex-lg-grow-0 text-center" href="/login">
            Log in
          </a>
          <a class="btn btn-primary px-3 flex-grow-1 flex-lg-grow-0 text-center" href="/register">
            Create account
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<div class="toast-stack">
  <% for (const msg of success) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm">
    <i class="bi bi-check-circle-fill me-2"></i><%= msg %><button
      class="btn-close"
      data-bs-dismiss="alert"
    ></button>
  </div>
  <% } %><% for (const msg of error) { %>
  <div class="alert alert-danger alert-dismissible fade show shadow-sm">
    <i class="bi bi-exclamation-circle-fill me-2"></i><%= msg %><button
      class="btn-close"
      data-bs-dismiss="alert"
    ></button>
  </div>
  <% } %>
</div>
