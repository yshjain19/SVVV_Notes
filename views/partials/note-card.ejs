<article class="note-card h-100">
  <div class="d-flex align-items-start gap-3">
    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf-fill"></i></div>
    <div class="flex-grow-1 min-w-0">
      <div class="d-flex justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <span class="tag"><%= note.subject && note.subject.name ? note.subject.name : note.subject %></span>
          <% if (note.isVerified) { %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center gap-1" style="font-size: 0.68rem; border-radius: 9999px; padding: 2px 7px;" title="Verified Note">
              <i class="bi bi-patch-check-fill text-primary"></i> Verified
            </span>
          <% } %>
        </div>
        <span class="small text-secondary text-nowrap">
          <i class="bi bi-calendar3 me-1"></i><%= new Date(note.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %>
        </span>
      </div>
      <h3 class="note-title mt-3">
        <a href="/notes/<%= note._id %>"><%= note.title %></a>
      </h3>
      <p class="note-summary"><%= note.description %></p>
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
        <% if (note.course) { %>
        <div class="small text-secondary">
          <i class="bi bi-book me-1"></i><%= note.course %>
        </div>
        <% } %>
        <% if (note.uploadedBy) { %>
        <div class="small text-secondary d-inline-flex align-items-center gap-1">
          <i class="bi bi-person me-1"></i>
          <a href="/users/<%= note.uploadedBy._id %>" class="text-secondary text-decoration-none fw-medium">
            <%= note.uploadedBy.fullName || note.uploadedBy.username %>
          </a>
          <% if (note.uploadedBy.isAdmin) { %>
            <i class="bi bi-patch-check-fill text-primary" title="Verified Admin" style="font-size: 0.85em;"></i>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="note-card-footer">
    <span><i class="bi bi-layers me-1"></i>Semester <%= note.semester %></span>
    <a
      class="btn btn-sm btn-outline-primary rounded-pill px-3"
      href="/notes/<%= note._id %>"
      >Open <i class="bi bi-arrow-up-right ms-1"></i
    ></a>
  </div>
</article>
