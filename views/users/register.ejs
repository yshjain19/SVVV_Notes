<% layout('layouts/boilerplate') %>
<section class="auth-shell">
  <div class="auth-visual">
    <div>
      <a href="/" class="d-inline-block text-white text-decoration-none mb-4 fs-2 fw-bold" style="letter-spacing: -0.5px;">
        SVVV_<span style="opacity: 0.9;">Notes</span>
      </a>
      <h1>Share knowledge.<br />Grow together.</h1>
      <p>
        A better, calmer way for the CSE student community to prepare and
        collaborate.
      </p>
    </div>
    <div class="auth-quote">
      <i class="bi bi-stars"></i>
      <p>
        Every useful note can make a difference to someone’s learning journey.
      </p>
      <span>SVVV_Notes community</span>
    </div>
  </div>
  <div class="auth-form-side">
    <form
      class="auth-form needs-validation"
      action="/register"
      method="POST"
      novalidate
    >
      <a class="navbar-brand d-lg-none mb-4 d-inline-flex align-items-center text-decoration-none fw-bold fs-4" href="/">
        <span>SVVV_<span class="text-primary">Notes</span></span>
      </a>
      <span class="section-kicker">GET STARTED</span>
      <h1>Create your account.</h1>
      <p class="mb-4 text-secondary">
        Join the SVVV CSE student community.
      </p>

      <a href="/auth/google" class="btn btn-google w-100 py-2">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
          <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
        </svg>
        <span>Sign up with Google</span>
      </a>

      <div class="auth-divider">
        <span>or</span>
      </div>

      <div class="row g-3">
        <div class="col-12">
          <input
            class="form-control"
            name="username"
            required
            placeholder="Username"
          />
          <div class="invalid-feedback">Please add a username.</div>
        </div>
        <div class="col-12">
          <input
            class="form-control"
            name="fullName"
            required
            placeholder="Full Name"
          />
          <div class="invalid-feedback">Please enter your full name.</div>
        </div>
        <div class="col-12">
          <input
            class="form-control"
            type="email"
            name="email"
            required
            placeholder="Email address"
          />
          <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>
        <div class="col-12">
          <select class="form-select" name="course" required>
            <option value="">Course</option>
            <option>Computer Science</option>
            <option>Information Technology</option>
            <option>AI & Data Science</option>
          </select>
          <div class="invalid-feedback">Please select a course.</div>
        </div>
        <div class="col-12">
          <select class="form-select" name="gender" required>
            <option value="">Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
          <div class="invalid-feedback">Please select your gender.</div>
        </div>
        <input type="hidden" name="semester" value="1" />
        <div class="col-12">
          <input
            class="form-control"
            type="password"
            name="password"
            required
            pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,}"
            placeholder="Password (Min 6 chars, 1 Upper, 1 Number)"
          />
          <div class="invalid-feedback">Password must be at least 6 characters, and contain at least one uppercase letter and one number.</div>
        </div>
      </div>
      <button class="btn btn-orange w-100 mt-4 py-2">
        Create Account
      </button>

      <p class="auth-switch">Already a member? <a href="/login">Sign in</a></p>
    </form>
  </div>
</section>

