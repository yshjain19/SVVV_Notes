<% layout('layouts/boilerplate') %>
<section class="auth-shell">
  <div class="auth-visual">
    <div>
      <a href="/" class="d-inline-block text-white text-decoration-none mb-4 fs-2 fw-bold" style="letter-spacing: -0.5px;">
        SVVV_<span style="opacity: 0.9;">Notes</span>
      </a>
      <h1>One place for<br />every study win.</h1>
      <p>
        Join a growing community of SVVV CSE students sharing what they learn.
      </p>
    </div>
    <div class="auth-quote">
      <i class="bi bi-quote"></i>
      <p>
        “I found a clean set of OS notes the night before my mid-sem.
        Lifesaver.”
      </p>
      <span>— SVVV CSE Student</span>
    </div>
  </div>
  <div class="auth-form-side">
    <form
      class="auth-form needs-validation"
      action="/login"
      method="POST"
      novalidate
    >
      <a class="navbar-brand d-lg-none mb-5 d-inline-flex align-items-center text-decoration-none fw-bold fs-4" href="/">
        <span>SVVV_<span class="text-primary">Notes</span></span>
      </a><span class="section-kicker">WELCOME BACK</span>
      <h1>Sign in to your account.</h1>
      <p class="mb-4 text-secondary">
        Pick up where your last study session ended.
      </p>
      <a href="/auth/google" class="btn btn-google w-100 py-2">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
          <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
        </svg>
        <span>Continue with Google</span>
      </a>

      <div class="auth-divider">
        <span>or</span>
      </div>

      <div class="mb-3">
        <input
          class="form-control"
          type="email"
          name="email"
          required
          placeholder="Email address"
          autocomplete="email"
        />
        <div class="invalid-feedback">Please enter your email address.</div>
      </div>
      <div class="mb-3">
        <input
          class="form-control"
          type="password"
          name="password"
          required
          placeholder="Password"
          autocomplete="current-password"
        />
        <div class="invalid-feedback">Please enter your password.</div>
      </div>

      <button class="btn btn-primary w-100 mt-2 py-2">
        Sign in <i class="bi bi-arrow-right ms-2"></i>
      </button>
      <div class="d-flex gap-2 mt-3">
        <a href="/forgot-password" class="btn btn-link btn-sm w-100 text-decoration-none">
          <i class="bi bi-key me-1"></i> Forgot Password?
        </a>
      </div>

      <p class="auth-switch">
        New to SVVV_Notes? <a href="/register">Create an account</a>
      </p>
    </form>
  </div>
</section>
