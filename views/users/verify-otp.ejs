<%- layout("layouts/boilerplate") %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-body p-4 p-sm-5">
          <div class="text-center mb-4">
            <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10" style="width: 64px; height: 64px;">
              <i class="bi bi-shield-check text-primary" style="font-size: 2rem;"></i>
            </div>
            <h2 class="card-title fw-bold text-dark mb-1">Verify Your Email</h2>
            <p class="text-muted small">Enter the 6-digit verification code sent to your email</p>
          </div>

          <form action="/verify-otp" method="POST" class="needs-validation" novalidate>
            <% if (email) { %>
              <input type="hidden" name="email" value="<%= email %>">
              <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-4 rounded-3">
                <div class="text-truncate me-2">
                  <small class="text-muted d-block" style="font-size: 0.75rem;">Sent to</small>
                  <strong class="text-dark small"><%= email %></strong>
                </div>
                <a href="/verify-otp" class="btn btn-sm btn-link text-decoration-none p-0" style="font-size: 0.8rem;">Change</a>
              </div>
            <% } else { %>
              <div class="mb-3">
                <label for="email" class="form-label fw-semibold small">Email Address</label>
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  placeholder="name@example.com"
                  required
                />
                <div class="invalid-feedback">Please enter your registered email address.</div>
              </div>
            <% } %>

            <div class="mb-3">
              <label for="otp" class="form-label fw-semibold small">6-Digit Verification Code</label>
              <input
                type="text"
                class="form-control form-control-lg text-center fw-bold"
                id="otp"
                name="otp"
                placeholder="······"
                maxlength="6"
                pattern="[0-9]{6}"
                required
                autofocus
                style="font-size: 26px; letter-spacing: 8px; font-family: monospace;"
              />
              <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted" style="font-size: 0.78rem;">
                  <i class="bi bi-clock me-1"></i>Expires in 10 minutes
                </small>
                <% if (email) { %>
                  <a href="/send-otp?email=<%= encodeURIComponent(email) %>" class="small text-primary fw-semibold text-decoration-none" style="font-size: 0.8rem;">
                    Resend Code
                  </a>
                <% } %>
              </div>
              <div class="invalid-feedback">Please enter the 6-digit code.</div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold mt-4 py-2" style="border-radius: 10px;">
              Verify & Proceed to Login
            </button>
          </form>

          <hr class="my-4 text-muted opacity-25">

          <div class="text-center">
            <p class="text-muted small mb-0">
              Already verified?
              <a href="/login" class="text-primary fw-semibold text-decoration-none">Sign in to your account</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .card {
    border-radius: 16px;
  }

  .form-control {
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .form-control:focus {
    border-color: #4f46e5;
    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
  }

  .btn-primary {
    background-color: #4f46e5;
    border-color: #4f46e5;
    border-radius: 10px;
  }

  .btn-primary:hover {
    background-color: #4338ca;
    border-color: #4338ca;
  }
</style>
