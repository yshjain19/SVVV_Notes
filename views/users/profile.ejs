<% layout('layouts/boilerplate') %>
<section class="profile-hero">
  <div class="container">
    <div class="profile-panel align-items-start">
      <div class="profile-avatar">
        <img
          src="<%=user.avatar.url%>"
          alt="<%=user.username%>'s profile image"
        />
      </div>
      <div class="d-flex flex-column gap-1">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
          <span class="section-kicker mb-0"><%= user.isAdmin ? 'ADMIN PROFILE' : 'STUDENT PROFILE' %></span>
          <% if (user.isAdmin) { %>
            <span class="badge bg-primary text-white d-inline-flex align-items-center gap-1" style="font-size: 0.72rem; border-radius: 9999px; padding: 2px 8px;">
              <i class="bi bi-patch-check-fill"></i> Admin
            </span>
          <% } %>
        </div>
        <h1 class="mb-0 fw-bold d-inline-flex align-items-center gap-2">
          <%= user.fullName || user.username %>
          <% if (user.isAdmin) { %>
            <i class="bi bi-patch-check-fill text-primary" title="Verified Admin" style="font-size: 0.9em;"></i>
          <% } %>
        </h1>
        <% if (user.fullName) { %>
          <span class="text-muted" style="font-size: 0.85rem; margin-top: -2px;">@<%= user.username %></span>
        <% } %>
        <div class="d-flex flex-column gap-2 mt-2">
          <p class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-mortarboard text-primary"></i><%= user.branch || 'Computer Science' %><% if (user.semester) { %> · Semester <%= user.semester %><% } %></p>
          <% if (user.email) { %>
            <p class="text-secondary mb-0 d-flex align-items-center gap-2" style="font-size: 0.85rem;"><i class="bi bi-envelope text-primary"></i><%= user.email %></p>
          <% } %>
          <% const totalUserDownloads = notes.reduce((sum, n) => sum + (n.downloadCount || 0), 0); %>
          <p class="text-secondary mb-0 d-flex align-items-center gap-2" style="font-size: 0.85rem;">
            <i class="bi bi-journal-bookmark text-primary"></i><%= notes.length %> <%= notes.length === 1 ? 'note shared' : 'notes shared' %>
            <span class="text-muted">•</span>
            <i class="bi bi-download text-primary"></i><%= totalUserDownloads %> <%= totalUserDownloads === 1 ? 'total download' : 'total downloads' %>
          </p>
        </div>
        <% if (currentUser && currentUser._id.equals(user._id)) { %>
          <div class="mt-2 d-flex gap-2">
            <a href="/users/<%= user._id %>/edit" class="btn btn-sm btn-soft"><i class="bi bi-pencil me-1"></i> Edit Profile</a>
            <form action="/logout" method="POST" style="display: inline;">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i> Logout</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="section-kicker">CONTRIBUTIONS</span>
        <h2 class="mb-0">Notes shared by <%=user.username%></h2>
      </div>
      <% if (isOwner) { %>
        <a href="/notes/new" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>Upload Note</a>
      <% } %>
    </div>
    <div class="row g-4">
      <%if(notes.length){notes.forEach(note=>{%>
      <div class="col-md-6 col-xl-4">
        <% if (isOwner && note.status !== 'approved') { %>
          <!-- Status card for owner's pending/rejected notes -->
          <div class="card h-100 border-0 shadow-sm" style="border-radius: 14px; position: relative; overflow: hidden;">
            <% if (note.status === 'pending') { %>
              <div style="position:absolute; top:0; left:0; right:0; height:3px; background: #F59E0B;"></div>
            <% } else { %>
              <div style="position:absolute; top:0; left:0; right:0; height:3px; background: #EF4444;"></div>
            <% } %>
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="fw-bold mb-0" style="font-size: 0.95rem; color: #1F2937; line-height: 1.3;">
                  <a href="/notes/<%= note._id %>" class="text-decoration-none text-dark"><%= note.title %></a>
                </h5>
                <% if (note.status === 'pending') { %>
                  <span class="badge bg-warning text-dark ms-2 flex-shrink-0" style="font-size: 0.68rem; border-radius: 999px;">⏳ Pending</span>
                <% } else { %>
                  <span class="badge bg-danger ms-2 flex-shrink-0" style="font-size: 0.68rem; border-radius: 999px;">❌ Rejected</span>
                <% } %>
              </div>
              <% if (note.status === 'pending') { %>
                <p class="text-muted mb-0" style="font-size: 0.8rem;">Awaiting admin review. Not yet publicly visible.</p>
              <% } else if (note.rejectionReason) { %>
                <p class="text-danger mb-0" style="font-size: 0.8rem;"><strong>Reason:</strong> <%= note.rejectionReason %></p>
                <a href="/notes/<%= note._id %>/edit" class="btn btn-outline-danger btn-sm mt-2" style="font-size: 0.78rem; border-radius: 8px;">Edit &amp; Resubmit</a>
              <% } else { %>
                <p class="text-muted mb-0" style="font-size: 0.8rem;">This note was not approved for public listing.</p>
                <a href="/notes/<%= note._id %>/edit" class="btn btn-outline-danger btn-sm mt-2" style="font-size: 0.78rem; border-radius: 8px;">Edit &amp; Resubmit</a>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <%- include('../partials/note-card', {note}) %>
        <% } %>
      </div>
      <%})}else{%>
      <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-journal-plus"></i></div>
        <h2>No notes shared yet</h2>
        <p>This student has not uploaded study material yet.</p>
      </div>
      <%}%>
    </div>
  </div>
</section>
