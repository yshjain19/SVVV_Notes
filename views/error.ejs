<% layout('layouts/boilerplate') %>
<section class="error-page">
  <div class="container text-center">
    <div class="error-code"><%=status%></div>
    <div class="empty-icon mx-auto"><i class="bi bi-map"></i></div>
    <h1><%= status === 404 ? 'This page took a study break.' : 'Something needs a quick fix.' %></h1>
    <p><%=message%></p>
    <a class="btn btn-primary px-4" href="/"
      ><i class="bi bi-house me-2"></i>Back home</a
    >
  </div>
</section>
