<% layout('layouts/boilerplate') %>
<section class="py-4 admin-section">
  <div class="container">
    
    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="section-kicker">ANALYTICS & CONTROL</span>
        <h1 class="mb-0 fw-bold" style="font-size: 1.85rem;">Admin Dashboard</h1>
      </div>
    </div>

    <!-- Section: Core Metrics -->
    <h3 class="fw-bold mb-3" style="font-size: 1.1rem;">Core Metrics</h3>
    <div class="row g-3 g-md-4 mb-4">
      <!-- Total Users -->
      <div class="col-sm-6 col-lg-3">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Total Users</span>
            <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-people-fill"></i></span>
          </div>
          <h2 class="mb-2 fw-bold" style="font-size: 2.2rem;"><%= totalUsers %></h2>
          <span class="fw-semibold text-success" style="font-size: 0.78rem;">+<%= usersDelta %> in last 7 days</span>
        </div>
      </div>
      <!-- Total Notes -->
      <div class="col-sm-6 col-lg-3">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Total Notes</span>
            <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-file-earmark-text-fill"></i></span>
          </div>
          <h2 class="mb-2 fw-bold" style="font-size: 2.2rem;"><%= totalNotes %></h2>
          <span class="fw-semibold text-success" style="font-size: 0.78rem;">+<%= notesDelta %> in last 7 days</span>
        </div>
      </div>
      <!-- Total Downloads -->
      <div class="col-sm-6 col-lg-3">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Total Downloads</span>
            <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-download"></i></span>
          </div>
          <h2 class="mb-2 fw-bold" style="font-size: 2.2rem;"><%= totalDownloads %></h2>
          <span class="fw-semibold text-success" style="font-size: 0.78rem;">+<%= downloadsDelta %> in last 7 days</span>
        </div>
      </div>
      <!-- Pending Notes -->
      <div class="col-sm-6 col-lg-3">
        <a href="/admin/notes" class="text-decoration-none">
          <div class="card admin-card border-0 shadow-sm p-4 h-100" style="transition: transform var(--transition), box-shadow var(--transition);">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Pending Review</span>
              <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-list-task"></i></span>
            </div>
            <h2 class="mb-2 fw-bold <%= pendingNotes > 0 ? 'text-danger' : '' %>" style="font-size: 2.2rem;"><%= pendingNotes %></h2>
            <span class="fw-semibold text-primary" style="font-size: 0.78rem;">Click to review →</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Section: Traffic Analysis -->
    <h3 class="fw-bold mb-3" style="font-size: 1.1rem;">Traffic Analysis</h3>
    <div class="row g-3 g-md-4 mb-5">
      <!-- Unique Downloads -->
      <div class="col-sm-6 col-lg-4">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Unique Downloads</span>
            <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-person-check-fill"></i></span>
          </div>
          <h2 class="mb-1 fw-bold" style="font-size: 2.2rem;">
            <%= uniqueDownloads %> <span class="text-secondary" style="font-size: 1rem; font-weight: normal;">(out of <%= totalDownloads %>)</span>
          </h2>
        </div>
      </div>
      <!-- Unique Sessions -->
      <div class="col-sm-6 col-lg-4">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Unique Sessions</span>
            <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-cursor-fill"></i></span>
          </div>
          <h2 class="mb-1 fw-bold" style="font-size: 2.2rem;"><%= uniqueSessions %></h2>
        </div>
      </div>
      <!-- Unique IPs -->
      <div class="col-sm-12 col-lg-4">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Unique IPs</span>
            <span class="text-secondary" style="font-size: 1.2rem;"><i class="bi bi-grid-3x3-gap-fill"></i></span>
          </div>
          <h2 class="mb-1 fw-bold" style="font-size: 2.2rem;"><%= uniqueIps %></h2>
        </div>
      </div>
    </div>

    <!-- Row: Top Notes & Verification Chart -->
    <div class="row g-4 mb-5">
      <!-- Top 5 Most Downloaded Notes (col-lg-8) -->
      <div class="col-lg-8">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <h3 class="fw-bold mb-4" style="font-size: 1.15rem;">Top 5 Most Downloaded Notes</h3>
          <div class="table-responsive">
            <table class="table align-middle" style="font-size: 0.9rem;">
              <thead class="table-light">
                <tr style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700;">
                  <th>Title</th>
                  <th>Downloads</th>
                  <th>Course</th>
                </tr>
              </thead>
              <tbody style="font-weight: 500;">
                <% if (topNotes.length) { %>
                  <% topNotes.forEach(note => { %>
                    <tr>
                      <td class="fw-semibold"><%= note.title %></td>
                      <td class="text-secondary"><%= note.downloadCount %></td>
                      <td class="text-secondary"><%= note.course || 'B.Tech CSE' %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="text-muted text-center py-4">No notes found with download counts yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Doughnut Chart: Note Status (col-lg-4) -->
      <div class="col-lg-4">
        <div class="card admin-card border-0 shadow-sm p-4 h-100">
          <h3 class="fw-bold mb-4" style="font-size: 1.15rem;">Note Moderation Status</h3>
          <div style="position: relative; height: 180px; margin: 0 auto 20px;">
            <canvas id="verificationChart" 
                    data-verified="<%= verifiedCount %>" 
                    data-unverified="<%= unverifiedCount %>" 
                    style="display: block; width: 100%; height: 100%;"></canvas>
          </div>
          <!-- Custom legends -->
          <div class="d-flex justify-content-center gap-4 mt-2">
            <div class="d-flex align-items-center gap-2">
              <span style="display: inline-block; width: 20px; height: 8px; background: #10B981; border-radius: 4px;"></span>
              <span class="text-secondary" style="font-size: 0.8rem; font-weight: 600;">Approved (<%= verifiedCount %>)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span style="display: inline-block; width: 20px; height: 8px; background: #F59E0B; border-radius: 4px;"></span>
              <span class="text-secondary" style="font-size: 0.8rem; font-weight: 600;">Pending/Rejected (<%= unverifiedCount %>)</span>
            </div>
          </div>
          <div class="mt-3 text-center">
            <a href="/admin/notes" class="btn btn-sm btn-outline-primary" style="border-radius: 999px; font-size: 0.8rem;">Open Moderation Queue →</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Section: Student & Moderator Control Panel -->
    <h3 class="fw-bold mb-3" style="font-size: 1.1rem;">Student Directory & Moderation</h3>
    <div class="row g-4">
      <!-- Left Column: Search & User list -->
      <div class="col-lg-5">
        <div class="card admin-card border-0 shadow-sm p-4" style="min-height: 480px;">
          <h3 class="fw-bold mb-3" style="font-size: 1.05rem;">Student Directory</h3>
          <div class="position-relative mb-2">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-secondary" style="left: 14px; pointer-events: none; z-index: 2;"></i>
            <input 
              type="text" 
              id="userSearchInput" 
              class="form-control rounded-pill ps-5 pe-5" 
              placeholder="Search by name or @username..." 
              autocomplete="off"
              style="font-size: 0.88rem; height: 42px; background: var(--card-bg-elevated, var(--card-bg)); border-color: var(--border); color: var(--text-primary);"
            />
            <button 
              type="button" 
              id="clearUserSearch" 
              class="btn btn-sm text-secondary position-absolute top-50 translate-middle-y end-0 me-2 border-0 bg-transparent d-none" 
              title="Clear search"
              style="z-index: 2;"
            >
              <i class="bi bi-x-circle-fill"></i>
            </button>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-3 px-1">
            <span class="text-secondary small" id="userSearchResultsCount">Showing <%= users.length %> students</span>
          </div>
          <div style="max-height: 350px; overflow-y: auto; padding-right: 5px;">
            <div class="list-group list-group-flush" id="usersListGroup">
              <% if (users.length) { %>
                <% users.forEach(u => { %>
                  <a href="/admin/dashboard?user=<%= u._id %>" 
                     class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-3 rounded-2 mb-2 user-list-item <%= selectedUser && selectedUser._id.toString() === u._id.toString() ? 'bg-primary-light text-primary fw-bold' : '' %>"
                     data-search-term="<%= (u.username + ' ' + (u.fullName || '')).toLowerCase() %>"
                     style="transition: background var(--transition);">
                     <div class="d-flex align-items-center gap-2">
                      <span class="avatar-sm" style="width: 28px; height: 28px; font-size: 0.75rem; background: <%= selectedUser && selectedUser._id.toString() === u._id.toString() ? 'var(--primary)' : 'var(--card-bg-elevated)' %>; color: <%= selectedUser && selectedUser._id.toString() === u._id.toString() ? '#fff' : 'var(--text-primary)' %>;">
                        <%= (u.username || 'U').charAt(0).toUpperCase() %>
                      </span>
                      <div>
                        <p class="mb-0 fw-semibold d-flex align-items-center gap-1" style="font-size: 0.88rem;">
                          <%= u.fullName || u.username %>
                          <% if (u.isAdmin) { %>
                            <i class="bi bi-patch-check-fill text-primary" title="Verified Admin" style="font-size: 0.85em;"></i>
                          <% } %>
                        </p>
                        <% if (u.fullName) { %>
                          <span class="text-secondary" style="font-size: 0.75rem; font-weight: normal;">@<%= u.username %></span>
                        <% } %>
                      </div>
                    </div>
                    <div class="text-end">
                      <span class="badge rounded-pill bg-light text-secondary border px-2 py-1" style="font-size: 0.7rem;"><%= u.notesCount %> notes</span>
                      <% if (u.isAdmin) { %>
                        <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">Admin</span>
                      <% } %>
                    </div>
                  </a>
                <% }) %>
              <% } else { %>
                <p class="text-muted text-center py-4">No users registered.</p>
              <% } %>
            </div>
            <div id="noUsersFoundMsg" class="text-center py-4 text-muted d-none">
              <i class="bi bi-search mb-2 d-block" style="font-size: 1.8rem; opacity: 0.35;"></i>
              <p class="mb-0 small">No students found matching "<span id="searchQueryDisplay"></span>"</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Detail Pane -->
      <div class="col-lg-7">
        <div class="card admin-card border-0 shadow-sm p-4" style="min-height: 480px;">
          <% if (!selectedUser) { %>
            <div class="d-flex flex-column align-items-center justify-content-center text-center my-auto py-5">
              <div class="text-secondary mb-3" style="font-size: 3rem; opacity: 0.4;"><i class="bi bi-person-bounding-box"></i></div>
              <h4 class="fw-bold text-secondary">No Student Selected</h4>
              <p class="text-muted" style="max-width: 320px; font-size: 0.88rem;">Select a registered student from the left directory to view full statistics, credentials, role settings, and shared files.</p>
            </div>
          <% } else { %>
            <div class="d-flex flex-column h-100">
              <!-- Header details -->
              <div class="d-flex flex-wrap align-items-center gap-3 border-bottom pb-4 mb-4">
                <div class="avatar-lg" style="width: 52px; height: 52px; border-radius: 12px; background: var(--primary-light); color: var(--primary); display: grid; place-items: center; font-size: 1.5rem; font-weight: 800;">
                  <%= (selectedUser.username || 'S').charAt(0).toUpperCase() %>
                </div>
                <div>
                  <h2 class="mb-0 fw-bold h4 d-flex align-items-center gap-2">
                    <%= selectedUser.fullName || selectedUser.username %>
                    <% if (selectedUser.isAdmin) { %>
                      <i class="bi bi-patch-check-fill text-primary" title="Verified Admin" style="font-size: 0.85em;"></i>
                    <% } %>
                  </h2>
                  <div class="d-flex gap-2 align-items-center mt-1">
                    <span class="text-muted" style="font-size: 0.8rem;">@<%= selectedUser.username %></span>
                    <span class="badge <%= selectedUser.isAdmin ? 'bg-primary' : 'bg-secondary' %>" style="font-size: 0.65rem;">
                      <%= selectedUser.isAdmin ? 'Admin' : 'Student' %>
                    </span>
                  </div>
                </div>
                <div class="ms-sm-auto d-flex gap-2 mt-3 mt-sm-0">
                  <form action="/admin/users/<%= selectedUser._id %>/toggle-admin" method="POST">
                    <button class="btn btn-sm btn-outline-primary">
                      <%= selectedUser.isAdmin ? 'Revoke Admin' : 'Make Admin' %>
                    </button>
                  </form>
                  <form action="/admin/users/<%= selectedUser._id %>/delete" method="POST" data-confirm="Are you sure you want to delete user account '<%= selectedUser.username %>' and all of their uploaded notes permanently? This cannot be undone.">
                    <button class="btn btn-sm btn-outline-danger">
                      Delete Account
                    </button>
                  </form>
                </div>
              </div>

              <!-- General details -->
              <h4 class="fw-bold mb-3" style="font-size: 0.95rem;">Student Details</h4>
              <div class="row g-3 mb-4 bg-light rounded-3 p-3 mx-0 border">
                <div class="col-sm-6">
                  <span class="d-block text-secondary" style="font-size: 0.75rem;">Email Address</span>
                  <strong style="font-size: 0.88rem;"><%= selectedUser.email %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="d-block text-secondary" style="font-size: 0.75rem;">Course & Branch</span>
                  <strong style="font-size: 0.88rem;"><%= selectedUser.course || 'B.Tech' %> · <%= selectedUser.branch || 'CSE' %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="d-block text-secondary" style="font-size: 0.75rem;">Current Semester</span>
                  <strong style="font-size: 0.88rem;"><%= selectedUser.semester ? 'Semester ' + selectedUser.semester : 'Not Specified' %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="d-block text-secondary" style="font-size: 0.75rem;">Joined Date</span>
                  <strong style="font-size: 0.88rem;">
                    <%= new Date(selectedUser.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                  </strong>
                </div>
              </div>

              <!-- Note list details -->
              <h4 class="fw-bold mb-3" style="font-size: 0.95rem;">Contributions (<%= selectedUserNotes.length %> Uploads)</h4>
              <div style="max-height: 220px; overflow-y: auto;">
                <% if (selectedUserNotes.length) { %>
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                      <thead class="table-light sticky-top">
                        <tr style="font-size: 0.75rem; text-transform: uppercase;">
                          <th>Title</th>
                          <th>Subject</th>
                          <th class="text-center">Downloads</th>
                          <th class="text-center">Verification</th>
                          <th class="text-end">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% selectedUserNotes.forEach(note => { %>
                          <tr>
                            <td>
                              <a href="/notes/<%= note._id %>" target="_blank" class="fw-bold text-decoration-none d-block text-truncate" style="max-width: 120px;" title="<%= note.title %>">
                                <%= note.title %>
                              </a>
                            </td>
                            <td><%= note.subject?.name || note.subject %></td>
                            <td class="text-center"><%= note.downloadCount %></td>
                            <td class="text-center">
                              <span class="badge <%= note.status === 'approved' ? 'bg-success' : note.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark' %>" style="font-size: 0.65rem;">
                                <%= note.status === 'approved' ? 'Approved' : note.status === 'rejected' ? 'Rejected' : 'Pending' %>
                              </span>
                            </td>
                            <td class="text-end">
                              <div class="d-flex justify-content-end gap-2">
                                <% if (note.status !== 'approved') { %>
                                  <form action="/admin/notes/<%= note._id %>/approve" method="POST">
                                    <button class="btn btn-xs btn-outline-success" style="font-size: 0.7rem; padding: 2px 6px;" title="Approve Note">
                                      <i class="bi bi-check-circle"></i>
                                    </button>
                                  </form>
                                <% } else { %>
                                  <form action="/admin/notes/<%= note._id %>/toggle-verify" method="POST">
                                    <button class="btn btn-xs btn-outline-warning" style="font-size: 0.7rem; padding: 2px 6px;" title="Move back to Pending">
                                      <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                  </form>
                                <% } %>
                                <form action="/admin/notes/<%= note._id %>/delete" method="POST" data-confirm="Are you sure you want to delete note '<%= note.title %>' permanently?">
                                  <button class="btn btn-xs btn-outline-danger" style="font-size: 0.7rem; padding: 2px 6px;" title="Delete Note">
                                    <i class="bi bi-trash"></i>
                                  </button>
                                </form>
                              </div>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <p class="text-muted text-center py-3 bg-light rounded-3 mb-0" style="font-size: 0.85rem;">This student has not shared any notes yet.</p>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Include Chart.js and search functionality -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initialize Doughnut Chart for Verification Status
    const ctx = document.getElementById('verificationChart');
    if (ctx) {
      const verified = parseInt(ctx.dataset.verified || '0', 10);
      const unverified = parseInt(ctx.dataset.unverified || '0', 10);
      const hasData = (verified + unverified) > 0;

      new Chart(ctx.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels: hasData ? ['Approved', 'Pending / Rejected'] : ['No Notes'],
          datasets: [{
            data: hasData ? [verified, unverified] : [1],
            backgroundColor: hasData ? ['#10B981', '#F59E0B'] : ['#E5E7EB'],
            borderWidth: 0,
            hoverOffset: hasData ? 4 : 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              enabled: hasData,
              callbacks: {
                label: function(context) {
                  let label = context.label || '';
                  if (label) {
                    label += ': ';
                  }
                  if (context.parsed !== undefined) {
                    label += context.parsed;
                  }
                  return label;
                }
              }
            }
          },
          cutout: '75%'
        }
      });
    }

    // 2. User Directory Search Filtering
    const searchInput = document.getElementById('userSearchInput');
    const clearBtn = document.getElementById('clearUserSearch');
    const countDisplay = document.getElementById('userSearchResultsCount');
    const noUsersMsg = document.getElementById('noUsersFoundMsg');
    const queryDisplay = document.getElementById('searchQueryDisplay');
    const items = document.querySelectorAll('.user-list-item');
    const totalCount = items.length;

    function filterUsers() {
      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      let matched = 0;

      if (clearBtn) {
        if (query) {
          clearBtn.classList.remove('d-none');
        } else {
          clearBtn.classList.add('d-none');
        }
      }

      items.forEach(item => {
        const searchContent = item.getAttribute('data-search-term');
        if (!query || (searchContent && searchContent.includes(query))) {
          item.style.setProperty('display', 'flex', 'important');
          matched++;
        } else {
          item.style.setProperty('display', 'none', 'important');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = query ? `Showing ${matched} of ${totalCount} students` : `Showing ${totalCount} students`;
      }

      if (noUsersMsg) {
        if (matched === 0 && query) {
          noUsersMsg.classList.remove('d-none');
          if (queryDisplay) queryDisplay.textContent = query;
        } else {
          noUsersMsg.classList.add('d-none');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterUsers);
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          filterUsers();
        }
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchInput.focus();
        filterUsers();
      });
    }
  });
</script>
