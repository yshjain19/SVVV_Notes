<% layout('layouts/boilerplate') %>
<section class="form-shell">
  <div class="container">
    <div class="form-heading text-center mx-auto">
      <span class="section-kicker">GET IN TOUCH</span>
      <h1>Say hello.</h1>
      <p>
        Have feedback, an idea, or spotted something that needs fixing? I’d love
        to hear it.
      </p>
    </div>
    <div class="contact-card">
      <div>
        <i class="bi bi-envelope-paper-heart"></i>
        <h2>Let’s make this better together.</h2>
        <p>
          SVVV_Notes grows with student feedback. Reach out with a suggestion
          or question.
        </p>
      </div>
      <a href="mailto:yshjain19@gmail.com" id="emailLink" class="btn btn-primary"
        >Email the team <i class="bi bi-arrow-up-right ms-2"></i
      ></a>
      <script>
        document.getElementById('emailLink').addEventListener('click', function(e) {
          const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
          if (!isMobile) {
            e.preventDefault();
            window.open('https://mail.google.com/mail/?view=cm&fs=1&to=yshjain19@gmail.com', '_blank');
          }
        });
      </script>
    </div>
  </div>
</section>
