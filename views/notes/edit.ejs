<% layout('layouts/boilerplate') %>
<section class="form-shell">
  <div class="container">
    <div class="form-heading">
      <a href="/notes/<%=note._id%>" class="back-link"
        ><i class="bi bi-arrow-left"></i> Back to note</a
      ><span class="section-kicker">EDIT NOTE</span>
      <h1>Keep it useful.</h1>
    </div>
    <form
      class="upload-card needs-validation"
      action="/notes/<%=note._id%>?_method=PUT"
      method="POST"
      enctype="multipart/form-data"
      novalidate
    >
      <div class="row g-4">
        <div class="col-md-8">
          <label class="form-label">Note title</label
          ><input
            class="form-control"
            name="note[title]"
            value="<%=note.title%>"
            required
          />
        </div>
        <div class="col-md-4">
          <label class="form-label">Subject</label
          ><input
            class="form-control"
            name="note[subject]"
            value="<%=note.subject ? note.subject.name : ''%>"
            required
          />
        </div>
        <div class="col-md-4">
          <label class="form-label">Course</label
          ><select class="form-select" name="note[course]" required>
            <% const courses = ["B.Tech CSE", "B.Tech IT", "B.Tech ECE", "B.Tech ME", "MBA", "BBA", "MCA", "BCA"]; %>
            <% for(let c of courses){ %>
            <option value="<%=c%>" <%=note.course === c ? 'selected' : ''%>><%=c%></option>
            <% } %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Semester</label
          ><select class="form-select" name="note[semester]" required>
            <% const semesters = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"]; %>
            <% for(let sem of semesters){ %>
            <option value="<%=sem%>" <%=note.semester === sem ? 'selected' : ''%>>Semester <%=sem%></option>
            <% } %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Replace PDF <span class="text-secondary fw-normal">(optional)</span></label
          ><input
            class="form-control"
            type="file"
            name="pdf"
          />
        </div>
        <div class="col-12">
          <label class="form-label">Description</label
          ><textarea
            class="form-control"
            rows="5"
            name="note[description]"
            required
          ><%=note.description%></textarea>
        </div>
      </div>
      <div class="d-flex justify-content-end gap-3 mt-4">
        <a href="/notes/<%=note._id%>" class="btn btn-light">Cancel</a
        ><button class="btn btn-primary px-4">Save changes</button>
      </div>
    </form>
  </div>
</section>
