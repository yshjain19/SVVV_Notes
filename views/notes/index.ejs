<% layout('layouts/boilerplate') %>
<section class="page-hero">
  <div class="container">
    <div class="eyebrow"><span></span>THE RESOURCE LIBRARY</div>
    <h1 class="text-center">Find the notes you need.</h1>
    <p>Browse peer-shared CSE resources, organized around your semester.</p>
    <form class="library-search" action="/notes" method="GET">
      <i class="bi bi-search"></i>
      <input name="q" value="<%= q %>" placeholder="Search by title, subject or keyword" />
      <select name="semester">
        <option value="">All semesters</option>
        <% const semesters = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"]; %>
        <% for(let sem of semesters){ %>
        <option value="<%=sem%>" <%= semester===sem ? 'selected' : '' %>>Semester <%=sem%></option>
        <% } %>
      </select>
      <button class="btn btn-primary">Search</button>
    </form>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <p class="mb-0 text-secondary">
        <strong class="text-dark"><%= typeof totalNotes !== 'undefined' ? totalNotes : notes.length %></strong> resources found<%= q ? ` for “${q}”` : '' %>
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <span class="ms-1 text-muted">(Page <%= currentPage %> of <%= totalPages %>)</span>
        <% } %>
      </p>
      <% if(currentUser){ %>
      <a href="/notes/new" class="btn btn-soft"><i class="bi bi-plus-lg me-1"></i>Upload note</a>
      <% } %>
    </div>
    <div class="row g-4">
      <% if(notes.length){ %>
      <% notes.forEach(note=>{ %>
      <div class="col-md-6 col-xl-4">
        <%- include('../partials/note-card',{note}) %>
      </div>
      <% }) %>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-search"></i></div>
        <h2>No notes found</h2>
        <p>Try a different subject, keyword, or semester.</p>
        <a href="/notes" class="btn btn-outline-primary">Clear filters</a>
      </div>
      <% } %>
    </div>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <nav class="mt-5 d-flex justify-content-center" aria-label="Notes library pagination">
      <ul class="pagination pagination-md gap-1 align-items-center">
        <% const queryParams = `${q ? `&q=${encodeURIComponent(q)}` : ''}${semester ? `&semester=${encodeURIComponent(semester)}` : ''}`; %>
        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
          <a class="page-link rounded-3" href="/notes?page=<%= currentPage - 1 %><%= queryParams %>" aria-label="Previous page">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <% if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
              <a class="page-link rounded-3 <%= p === currentPage ? 'fw-bold' : '' %>" href="/notes?page=<%= p %><%= queryParams %>"><%= p %></a>
            </li>
          <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
            <li class="page-item disabled"><span class="page-link border-0 text-muted">...</span></li>
          <% } %>
        <% } %>
        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
          <a class="page-link rounded-3" href="/notes?page=<%= currentPage + 1 %><%= queryParams %>" aria-label="Next page">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
    <% } %>
  </div>
</section>
